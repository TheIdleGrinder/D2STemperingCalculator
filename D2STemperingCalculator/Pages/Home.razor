@page "/"
@using System.Globalization
@using System.Text.Json
@using D2STemperingCalculator.Models
@using D2STemperingCalculator.Services
@inject IJSRuntime JS

<PageTitle>D2S Tempering Calculator</PageTitle>

<h1>D2S Tempering Calculator</h1>
<p class="text-muted">
    Find efficient tempering strategies for D2 Survivors.
</p>

<div class="d-flex gap-2 flex-wrap mb-4">
    <button class="btn btn-outline-primary"
            disabled="@busy"
            @onclick="NewItem">
        New Item
    </button>
    <button class="btn btn-primary"
            disabled="@(busy || !CanSave)"
            @onclick="SaveItemAsync">
        Save Item
    </button>
    <button class="btn btn-outline-primary"
            disabled="@busy"
            @onclick="ShowSavedItemsAsync">
        Load Item
    </button>
</div>

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert alert-info" role="status">@message</div>
}

@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger" role="alert">@error</div>
}

@if (showSavedItems)
{
    <section class="card mb-4" aria-labelledby="saved-items-heading">
        <div class="card-body">
            <h2 id="saved-items-heading" class="h4">Saved items</h2>

            @if (savedItems.Count == 0)
            {
                <p>No saved items found.</p>
            }
            else
            {
                <div class="list-group mb-3">
                    @foreach (var entry in savedItems.OrderBy(
                        entry => entry.Key,
                        StringComparer.Ordinal))
                    {
                        <button class="list-group-item list-group-item-action"
                                @onclick="() => LoadItem(entry.Value)">
                            @entry.Key
                        </button>
                    }
                </div>
            }

            <button class="btn btn-outline-secondary"
                    @onclick="() => showSavedItems = false">
                Cancel
            </button>
        </div>
    </section>
}

<div class="row g-4">
    <section class="col-12 col-xl-6" aria-labelledby="item-heading">
        <div class="card h-100">
            <div class="card-body">
                <h2 id="item-heading" class="h4">Item</h2>

                <fieldset disabled="@busy">
                    <label for="item-name" class="form-label">Item name</label>
                    <input id="item-name"
                           class="form-control form-control-lg mb-2"
                           placeholder="Enter item name"
                           @bind="item.Name" />

                    <p class="text-muted small">
                        A name is required to save. Saving replaces an item
                        with the same name.
                    </p>

                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead>
                                <tr>
                                    <th scope="col">Affix name</th>
                                    <th scope="col">Score per improvement</th>
                                    <th scope="col">Remove</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (TemperingAffix affix in item.Affixes)
                                {
                                    <tr @key="affix">
                                        <td>
                                            <input class="form-control"
                                                   aria-label="Affix name"
                                                   placeholder="Optional"
                                                   @bind="affix.Name" />
                                        </td>
                                        <td>
                                            <input type="number"
                                                   class="form-control"
                                                   aria-label="Score per improvement"
                                                   min="0"
                                                   max="1"
                                                   step="0.001"
                                                   @bind="affix.Value"
                                                   @bind:after="RefreshAnalysis" />
                                        </td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-danger"
                                                    aria-label="Remove affix"
                                                    disabled="@(item.Affixes.Count <= 2)"
                                                    @onclick="() => RemoveAffix(affix)">
                                                Remove
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <button class="btn btn-outline-secondary" @onclick="AddAffix">
                        Add Affix
                    </button>
                    <p class="text-muted small mt-2 mb-0">
                        At least two affixes are required. Each successful
                        temper selects an affix with equal probability.
                    </p>
                </fieldset>
            </div>
        </div>
    </section>

    <section class="col-12 col-xl-6" aria-labelledby="analysis-heading">
        <div class="card h-100">
            <div class="card-body">
                <h2 id="analysis-heading" class="h4">Analysis</h2>

                <label for="target-score" class="form-label">
                    Target tempering score
                </label>
                <input id="target-score"
                       type="number"
                       class="form-control mb-3"
                       min="0"
                       max="10"
                       step="0.001"
                       disabled="@busy"
                       @bind="targetScore"
                       @bind:after="RefreshAnalysis" />

                @if (analysis is not null)
                {
                    <dl class="row">
                        <dt class="col-8">Expected score at level 10</dt>
                        <dd class="col-4">@Number(analysis.ExpectedScore)</dd>

                        <dt class="col-8">Chance to reach target at level 10</dt>
                        <dd class="col-4">
                            @analysis.TargetProbability.ToString("P4", English)
                        </dd>
                    </dl>

                    @if (!analysis.IsReachable)
                    {
                        <div class="alert alert-warning">
                            This target cannot be reached at level 10
                            with these affix values.
                        </div>
                    }
                }

                <button class="btn btn-primary"
                        disabled="@(busy || analysis is null || !analysis.IsReachable)"
                        @onclick="CalculateStrategyAsync">
                    @(busy ? "Calculating…" : "Calculate Strategy")
                </button>

                @if (busy)
                {
                    <p class="mt-3" role="status">
                        Comparing tempering and cleaning costs…
                    </p>
                }

                @if (strategy is not null)
                {
                    <div class="alert alert-success mt-3">
                        Expected total cost:
                        <strong>@Number(strategy.ExpectedEssences) essences</strong>
                    </div>

                    <table class="table">
                        <thead>
                            <tr>
                                <th scope="col">Tempering level</th>
                                <th scope="col">Minimum score to continue</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (TemperingThreshold threshold in strategy.Thresholds)
                            {
                                <tr>
                                    <td>@threshold.Level</td>
                                    <td>
                                        @(threshold.MinimumScore is double score
                                            ? Number(score)
                                            : "Clean unless target reached")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <p class="small">
                        Below the threshold, clean for one essence and restart.
                        At or above it, continue tempering. Stop immediately
                        when the target is reached. If level 10 misses the target,
                        clean and restart.
                    </p>
                }

                <hr />

                <p class="text-muted small mb-2">
                    Probabilities and strategies use affix values rounded to
                    0.001. Thresholds show the smallest reachable score for each
                    level. The expected score uses the original values.
                </p>
                <p class="text-muted small mb-0">
                    The level-10 probability describes an uninterrupted run
                    without cleaning. Strategy costs include failed tempering
                    attempts and cleaning, starting from level 0.
                    Hell Forge and obtaining a new item are not included.
                </p>
            </div>
        </div>
    </section>
</div>

@code {
    private const string StorageKey = "d2s-tempering-calculator.items.v1";

    private static readonly CultureInfo English =
        CultureInfo.GetCultureInfo("en-US");

    private TemperingItem item = new();
    private Dictionary<string, TemperingItem> savedItems = new();
    private TemperingAnalysis? analysis;
    private TemperingStrategy? strategy;
    private double targetScore = 5;
    private bool busy;
    private bool showSavedItems;
    private string? message;
    private string? error;

    private bool CanSave =>
        !string.IsNullOrWhiteSpace(item.Name) &&
        item.Affixes.Count >= 2 &&
        item.Affixes.All(affix =>
            double.IsFinite(affix.Value) &&
            affix.Value >= 0 &&
            affix.Value <= 1);

    protected override void OnInitialized()
    {
        RefreshAnalysis();
    }

    private static string Number(double value)
    {
        return value.ToString("N3", English);
    }

    private void RefreshAnalysis()
    {
        strategy = null;
        analysis = null;
        error = null;
        message = null;

        try
        {
            analysis = new TemperingAnalysis(item, targetScore);
        }
        catch (ArgumentException exception)
        {
            error = exception.Message;
        }
    }

    private void NewItem()
    {
        item = new TemperingItem();
        showSavedItems = false;
        RefreshAnalysis();
    }

    private void AddAffix()
    {
        item.Affixes.Add(new TemperingAffix());
        RefreshAnalysis();
    }

    private void RemoveAffix(TemperingAffix affix)
    {
        if (item.Affixes.Count > 2)
        {
            item.Affixes.Remove(affix);
            RefreshAnalysis();
        }
    }

    private async Task<Dictionary<string, TemperingItem>> ReadSavedItemsAsync()
    {
        string? json = await JS.InvokeAsync<string?>(
            "localStorage.getItem",
            StorageKey);

        if (json is null)
        {
            return new Dictionary<string, TemperingItem>();
        }

        var items = JsonSerializer.Deserialize<Dictionary<string, TemperingItem>>(json)
            ?? throw new JsonException("Invalid saved item collection.");

        foreach (var entry in items)
        {
            if (string.IsNullOrWhiteSpace(entry.Key) ||
                entry.Value is null ||
                entry.Value.Affixes is null ||
                entry.Value.Affixes.Count < 2 ||
                entry.Value.Affixes.Any(affix =>
                    affix is null ||
                    !double.IsFinite(affix.Value) ||
                    affix.Value < 0 ||
                    affix.Value > 1))
            {
                throw new JsonException("Invalid saved item.");
            }

            entry.Value.Name = entry.Key;
        }

        return items;
    }

    private async Task SaveItemAsync()
    {
        if (!CanSave || busy)
        {
            return;
        }

        busy = true;
        error = null;
        message = null;

        try
        {
            var items = await ReadSavedItemsAsync();
            items[item.Name] = Clone(item);

            await JS.InvokeVoidAsync(
                "localStorage.setItem",
                StorageKey,
                JsonSerializer.Serialize(items));

            savedItems = items;
            message = $"Saved \"{item.Name}\".";
        }
        catch (JSException)
        {
            error = "Could not save the item. Browser storage may be unavailable or full.";
        }
        catch (JsonException)
        {
            error = "Saved data is invalid. It was not overwritten.";
        }
        finally
        {
            busy = false;
        }
    }

    private async Task ShowSavedItemsAsync()
    {
        busy = true;
        error = null;
        message = null;

        try
        {
            savedItems = await ReadSavedItemsAsync();
            showSavedItems = true;
        }
        catch (JSException)
        {
            error = "Could not access browser storage.";
        }
        catch (JsonException)
        {
            error = "Saved data is invalid and could not be loaded.";
        }
        finally
        {
            busy = false;
        }
    }

    private void LoadItem(TemperingItem savedItem)
    {
        item = Clone(savedItem);
        showSavedItems = false;
        RefreshAnalysis();
        message = $"Loaded \"{item.Name}\".";
    }

    private async Task CalculateStrategyAsync()
    {
        if (busy || analysis is null || !analysis.IsReachable)
        {
            return;
        }

        busy = true;
        strategy = null;
        error = null;
        message = null;

        try
        {
            // Render the busy state before starting the calculation.
            await Task.Delay(1);
            strategy = await analysis.CalculateStrategyAsync();
        }
        catch (InvalidOperationException exception)
        {
            error = exception.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private static TemperingItem Clone(TemperingItem source)
    {
        return new TemperingItem
        {
            Name = source.Name,
            Affixes = source.Affixes.Select(affix => new TemperingAffix
            {
                Name = affix.Name,
                Value = affix.Value
            }).ToList()
        };
    }
}
